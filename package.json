{
  "name": "chicken-badminton",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test --experimental-test-isolation=none tests/*.test.js",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --project demo-chicken-badminton --only auth,firestore",
    "test:emulators": "firebase emulators:exec --project demo-chicken-badminton --only auth,firestore \"npm test && npm run test:e2e\"",
    "migrate": "node scripts/migrate-legacy.mjs",
    "build:production": "vite build --mode production && node scripts/check-production.mjs"
  },
  "dependencies": {
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^14.0.0",
    "vite": "^7.0.0"
  }
}
