rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 資料模型：profiles/{id} = id、name(1–80)、ownerUid、createdAt、updatedAt。
    // games 與 settings/frequentPlayers 的擁有者繼承自父 profile。
    // 未綁定 ownerUid 的舊資料預設封鎖；僅管理員可指派歸屬。
    // game：固定欄位、型別與集合上限、revision；時間由伺服器驗證。
    // shareLinks 與 gameShares 不再開放，所有未列出的路徑一律拒絕。
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function ownsProfile(id) {
      return signedIn() && get(/databases/$(database)/documents/profiles/$(id)).data.ownerUid == request.auth.uid;
    }
    function validId(id) { return id is string && id.matches('^[A-Za-z0-9_-]{1,100}$'); }
    function boundedText(value, max) { return value is string && value.size() <= max; }
    function profileExists(id) { return exists(/databases/$(database)/documents/profiles/$(id)); }
    function validProfile(d, id) {
      return validId(id) && d.keys().hasAll(['id','name','ownerUid','createdAt','updatedAt'])
        && d.keys().hasOnly(['id','name','ownerUid','createdAt','updatedAt'])
        && d.id == id && d.ownerUid == request.auth.uid && boundedText(d.ownerUid,128) && boundedText(d.name,80) && d.name.size() > 0
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function validGame(d, id) {
      return validId(id)
        && d.keys().hasAll(['id','name','date','players','currentTeams','schedules','matchMode',
          'pendingRestMsg','needsInitialSchedule','savedTeamDraft','savedDraftMode',
          'savedDraftRestMsg','savedDraftRestPlayer','savedDraftUpdatedAt','revision',
          'deletedAt','createdAt','updatedAt','lastUpdated'])
        && d.keys().hasOnly(['id','name','date','players','currentTeams','schedules','matchMode',
          'pendingRestMsg','needsInitialSchedule','savedTeamDraft','savedDraftMode',
          'savedDraftRestMsg','savedDraftRestPlayer','savedDraftUpdatedAt','revision',
          'deletedAt','createdAt','updatedAt','lastUpdated'])
        && d.id == id && boundedText(d.name,120) && d.name.size() > 0 && boundedText(d.date,40)
        && d.players is list && d.players.size() <= 20
        && d.currentTeams is list && d.currentTeams.size() <= 20
        && d.schedules is list && d.schedules.size() <= 100
        && d.savedTeamDraft is list && d.savedTeamDraft.size() <= 20
        && d.matchMode in ['single','round-robin','single-elimination']
        && d.savedDraftMode in ['','single','round-robin','single-elimination']
        && boundedText(d.pendingRestMsg,4000) && boundedText(d.savedDraftRestMsg,4000)
        && d.needsInitialSchedule is bool
        && (d.savedDraftRestPlayer == null || d.savedDraftRestPlayer is map)
        && (d.savedDraftUpdatedAt == null || boundedText(d.savedDraftUpdatedAt,40))
        && d.revision is int && d.revision > 0 && d.revision <= 9007199254740991
        && (d.deletedAt == null || d.deletedAt is timestamp)
        && d.createdAt is timestamp && d.updatedAt == request.time
        && boundedText(d.lastUpdated,40);
    }
    function validRoster(d) {
      return d.keys().hasAll(['players','revision','updatedAt'])
        && d.keys().hasOnly(['players','revision','updatedAt'])
        && d.players is list && d.players.size() <= 200
        && d.revision is int && d.revision > 0 && d.revision <= 9007199254740991
        && d.updatedAt == request.time;
    }
    match /profiles/{profileId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && validProfile(request.resource.data,profileId)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && validProfile(request.resource.data, profileId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
      match /games/{gameId} {
        allow read: if ownsProfile(profileId);
        allow create: if ownsProfile(profileId) && validGame(request.resource.data,gameId)
          && request.resource.data.revision == 1 && request.resource.data.deletedAt == null
          && request.resource.data.createdAt == request.time;
        allow update: if ownsProfile(profileId) && validGame(request.resource.data,gameId)
          && resource.data.deletedAt == null && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.name == resource.data.name && request.resource.data.date == resource.data.date
          && (request.resource.data.deletedAt == null || request.resource.data.deletedAt == request.time);
        allow delete: if false;
      }
      match /settings/{settingId} {
        allow read: if ownsProfile(profileId) && settingId == 'frequentPlayers';
        allow create: if ownsProfile(profileId) && settingId == 'frequentPlayers'
          && validRoster(request.resource.data) && request.resource.data.revision == 1;
        allow update: if ownsProfile(profileId) && settingId == 'frequentPlayers'
          && validRoster(request.resource.data) && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
